// Tests M15F du vrai UpdateCustomerForm, exécutés par
// run_update_customer_form_tests.py dans un miroir où seul CustomerUseCase est
// remplacé par un double enregistreur. Données entièrement fictives.
import 'package:back_office_tribuneo_v2/domain/models/entity_model.dart';
import 'package:back_office_tribuneo_v2/domain/usecases/customer_usecase.dart';
import 'package:back_office_tribuneo_v2/presentation/utils/_global.dart';
import 'package:back_office_tribuneo_v2/presentation/widgets/forms/neo_input.dart';
import 'package:back_office_tribuneo_v2/presentation/widgets/forms/customers/update_customers_form.dart';
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:google_fonts/google_fonts.dart';

const String kName = 'Nom du client';
const String kMail = 'Email du client';
const String kSiret = 'Siret du client';
const String kPhone = 'Téléphone du client';
const String kCode = 'Code du client';

EntityModel fictiveCustomer({String? code, String? siret = '00000000000000'}) => EntityModel.fromJson({
      'id': 4242,
      'name': 'Client Fictif',
      'email': 'contact@exemple.test',
      'siret': siret,
      'phone': '0600000000',
      'code': code,
      'accept_demat': true,
    });

Map<String, dynamic> expectedPayload({required String name, required String code, String siret = '00000000000000'}) => {
      'id': 4242,
      'name': name,
      'email': 'contact@exemple.test',
      'siret': siret,
      'code': code,
      'phone': '0600000000',
      'type': 'customer',
      'fund_amount': null,
      'accept_demat': 0,
      'activity_sectors': [],
    };

/// Champ éditable d'un NeoInput, repéré par son libellé.
Finder field(String hint) => find.descendant(
      of: find.byWidgetPredicate((w) => w is NeoInput && w.hintText == hint),
      matching: find.byType(EditableText),
    );

String textOf(WidgetTester tester, String hint) =>
    tester.widget<EditableText>(field(hint)).controller.text;

/// Ouvre le formulaire comme CustomersContentView._genUpdate et collecte la
/// valeur de retour du dialogue.
Future<List<bool?>> openForm(WidgetTester tester, EntityModel customer) async {
  tester.view.physicalSize = const Size(1600, 1400);
  tester.view.devicePixelRatio = 1.0;
  addTearDown(tester.view.reset);
  final results = <bool?>[];
  await tester.pumpWidget(MaterialApp(
    scaffoldMessengerKey: snackbarKey,
    home: Scaffold(
      body: Builder(
        builder: (context) => TextButton(
          onPressed: () async {
            results.add(await showDialog<bool>(
              context: context,
              builder: (_) => UpdateCustomerForm(entity: customer),
            ));
          },
          child: const Text('ouvrir'),
        ),
      ),
    ),
  ));
  await tester.tap(find.text('ouvrir'));
  await tester.pumpAndSettle();
  return results;
}

Future<void> save(WidgetTester tester) async {
  await tester.ensureVisible(find.text('Enregistrer'));
  await tester.tap(find.text('Enregistrer'));
  await tester.pumpAndSettle();
}

void main() {
  setUpAll(() {
    // Polices non embarquées : jamais de téléchargement pendant les tests.
    GoogleFonts.config.allowRuntimeFetching = false;
  });

  setUp(CustomerUseCase.reset);

  testWidgets('le code existant reste affiché, sans saisie possible, et part inchangé',
      (tester) async {
    final results = await openForm(tester, fictiveCustomer(code: 'FICTIF-01'));

    expect(textOf(tester, kCode), 'FICTIF-01');

    // Témoin : un champ modifiable ouvre bien une connexion clavier.
    await tester.showKeyboard(field(kName));
    expect(tester.testTextInput.hasAnyClients, isTrue);
    await tester.enterText(field(kName), 'Client Fictif Corrigé');

    // Le champ Code prend le focus mais n'ouvre aucune saisie.
    await tester.showKeyboard(field(kCode));
    expect(tester.testTextInput.hasAnyClients, isFalse);
    expect(textOf(tester, kCode), 'FICTIF-01');

    await save(tester);

    expect(CustomerUseCase.updates, [
      expectedPayload(name: 'Client Fictif Corrigé', code: 'FICTIF-01'),
    ]);
    expect(results, [true]);
  });

  for (final absent in <String?>[null, '', '   ']) {
    testWidgets('une fiche au code absent (${absent == null ? 'null' : '"$absent"'}) '
        'enregistre la correction des autres champs', (tester) async {
      final results = await openForm(tester, fictiveCustomer(code: absent));

      await tester.enterText(field(kName), 'Client Fictif Corrigé');
      await save(tester);

      // Aucun code fabriqué : la valeur chargée (ou '' pour null) est renvoyée
      // comme avant, et l'API de modification ne la lit pas.
      expect(CustomerUseCase.updates, [
        expectedPayload(name: 'Client Fictif Corrigé', code: absent ?? ''),
      ]);
      expect(results, [true]);
      expect(find.text('Modification du client réussie'), findsOneWidget);
    });
  }

  for (final siret in <String?>[null, '', '1234']) {
    testWidgets('le SIRET ${siret ?? 'null'} garde le comportement local existant',
        (tester) async {
      final results = await openForm(tester, fictiveCustomer(code: null, siret: siret));
      await tester.enterText(field(kName), 'Client Fictif Corrigé');
      await save(tester);
      expect(CustomerUseCase.updates, [
        expectedPayload(name: 'Client Fictif Corrigé', code: '', siret: siret ?? ''),
      ]);
      expect(results, [true]);
    });
  }

  testWidgets('le SIRET garde le filtrage chiffres et la limite de 14 caractères',
      (tester) async {
    await openForm(tester, fictiveCustomer(code: 'FICTIF-01'));
    await tester.enterText(field(kSiret), '');
    await tester.enterText(field(kSiret), 'ab1234567890123456');
    expect(textOf(tester, kSiret), '12345678901234');
    await save(tester);
    expect(CustomerUseCase.updates, [
      expectedPayload(name: 'Client Fictif', code: 'FICTIF-01', siret: '12345678901234'),
    ]);
  });

  const invalidInputs = <String, String>{
    kName: '   ',
    kMail: 'pas-une-adresse',
    kPhone: '12',
  };
  for (final entry in invalidInputs.entries) {
    testWidgets('« ${entry.key} » invalide bloque toujours l’envoi, même sans code',
        (tester) async {
      final results = await openForm(tester, fictiveCustomer(code: null));

      await tester.enterText(field(entry.key), entry.value);
      await save(tester);

      expect(CustomerUseCase.updates, isEmpty);
      expect(results, isEmpty);
      expect(find.byType(UpdateCustomerForm), findsOneWidget);
    });
  }

  testWidgets('un échec simulé garde le formulaire ouvert et réactivable',
      (tester) async {
    CustomerUseCase.failure = Exception('échec simulé');
    final results = await openForm(tester, fictiveCustomer(code: 'FICTIF-01'));

    await save(tester);

    expect(CustomerUseCase.updates, hasLength(1));
    expect(results, isEmpty);
    expect(find.text('Erreur lors de la modification du client.'), findsOneWidget);
    expect(find.text('Enregistrer'), findsOneWidget);
  });
}
