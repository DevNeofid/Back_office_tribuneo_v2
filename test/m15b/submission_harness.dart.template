class Post {
  final String path;
  final String body;
  final String? tenant;
  final Map<String, String>? headers;
  Post(this.path, this.body, this.tenant, this.headers);
  Map<String, dynamic> get json => jsonDecode(body) as Map<String, dynamic>;
}
class MemoryTransport {
  final posts = <Post>[];
  final gets = <String>[];
  bool fail = false;
  final events = Completer<Reply>();
  Future<Reply> post(String path, String body,
      {String? overrideTenant, Map<String, String>? headers}) async {
    posts.add(Post(path, body, overrideTenant, headers));
    if (fail) throw StateError('Synthetic transport failure');
    return Reply(200, <String, dynamic>{});
  }
  Future<Reply> get(String path) {
    gets.add(path);
    return events.future;
  }
}
