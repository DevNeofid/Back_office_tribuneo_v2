{
  "openapi": "3.1.0",
  "info": {
    "title": "Tribuneo comparaison enrichissement via chat",
    "version": "chat-1.0.0"
  },
  "security": [
    {
      "humanBearer": []
    }
  ],
  "paths": {
    "/chat/sessions": {
      "post": {
        "parameters": [
          {
            "name": "X-Tenant",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "tribuneo_cci04"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": false,
            "description": "Obligatoire pour une session humaine web ; allowlist existante",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session dédiée neuve ou ordinaire (contrat inchangé)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{32}$"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Refus existant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/chat/sessions/{id}/messages": {
      "post": {
        "parameters": [
          {
            "name": "X-Tenant",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "tribuneo_cci04"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": false,
            "description": "Obligatoire pour une session humaine web ; allowlist existante",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Message"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Réponse ordinaire ou comparaison ; bloc généré par le serveur",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "reply"
                      ],
                      "properties": {
                        "reply": {
                          "$ref": "#/components/schemas/Reply"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "CHAT_BAD_INPUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentification existante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "CHAT_FORBIDDEN / contrôle tenant existant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "CHAT_CONTEXT_NOT_FOUND / CHAT_SESSION_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "CHAT_CONTEXT_STALE / CHAT_CONTEXT_CONFLICT / CHAT_REQUEST_CONFLICT / CHAT_BUSY",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "CHAT_RATE_LIMIT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "CHAT_CONTEXT_UNAVAILABLE / CHAT_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "humanBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Message": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message",
          "request_id"
        ],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "enrichment_context": {
            "$ref": "#/components/schemas/EnrichmentContext"
          }
        }
      },
      "EnrichmentContext": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "batch_id",
          "row_id",
          "proposal_id",
          "expected_version"
        ],
        "properties": {
          "batch_id": {
            "type": "integer",
            "minimum": 1
          },
          "row_id": {
            "type": "integer",
            "minimum": 1
          },
          "proposal_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "CandidateReference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "EnrichmentCandidates": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "batch_id",
          "row_id",
          "proposal_id",
          "expected_version",
          "candidates"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "enrichment_candidates"
          },
          "batch_id": {
            "type": "integer",
            "minimum": 1
          },
          "row_id": {
            "type": "integer",
            "minimum": 1
          },
          "proposal_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          },
          "candidates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/CandidateReference"
            }
          }
        }
      },
      "Reply": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "blocks",
          "tools"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 80000
          },
          "blocks": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "$ref": "#/components/schemas/EnrichmentCandidates"
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "type",
              "description",
              "details"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
