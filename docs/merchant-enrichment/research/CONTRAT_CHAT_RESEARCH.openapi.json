{
  "openapi": "3.1.0",
  "info": {
    "title": "Tribuneo chat research — extension additive E06 à consolider par M12",
    "version": "1.2.0",
    "description": "Extension du dialogue uniquement ; routes ciblées et règles métier dans le contrat v1.2 gelé. Blocs construits par le serveur après revalidation humaine."
  },
  "servers": [
    {
      "url": "/",
      "description": "API Tribuneo du BO, jamais un appel fournisseur depuis Flutter"
    }
  ],
  "security": [
    {
      "SessionAuth": []
    }
  ],
  "paths": {
    "/chat/sessions": {
      "post": {
        "parameters": [
          {
            "name": "X-Tenant",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "tribuneo_cci04"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": false,
            "description": "Obligatoire pour une session humaine web ; allowlist existante",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session dédiée neuve ou ordinaire (contrat inchangé)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{32}$"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Refus existant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatError"
                }
              }
            }
          }
        },
        "security": [
          {
            "humanBearer": []
          }
        ]
      }
    },
    "/chat/sessions/{id}/messages": {
      "post": {
        "parameters": [
          {
            "name": "X-Tenant",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "tribuneo_cci04"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": false,
            "description": "Obligatoire pour une session humaine web ; allowlist existante",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatMessage"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Réponse ordinaire ou comparaison ; bloc généré par le serveur",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "reply"
                      ],
                      "properties": {
                        "reply": {
                          "$ref": "#/components/schemas/ChatReply"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "CHAT_BAD_INPUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatError"
                }
              }
            }
          },
          "401": {
            "description": "Authentification existante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatError"
                }
              }
            }
          },
          "403": {
            "description": "CHAT_FORBIDDEN / contrôle tenant existant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatError"
                }
              }
            }
          },
          "404": {
            "description": "CHAT_CONTEXT_NOT_FOUND / CHAT_SESSION_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatError"
                }
              }
            }
          },
          "409": {
            "description": "CHAT_CONTEXT_STALE / CHAT_CONTEXT_CONFLICT / CHAT_REQUEST_CONFLICT / CHAT_BUSY",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatError"
                }
              }
            }
          },
          "429": {
            "description": "CHAT_RATE_LIMIT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatError"
                }
              }
            }
          },
          "503": {
            "description": "CHAT_CONTEXT_UNAVAILABLE / CHAT_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatError"
                }
              }
            }
          }
        },
        "security": [
          {
            "humanBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authentification humaine existante + NETWORK_ADMIN et X-Tenant ; ne pas créer une nouvelle auth"
      },
      "humanBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ChatMessage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message",
          "request_id"
        ],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "enrichment_context": {
            "$ref": "#/components/schemas/ChatEnrichmentContext"
          }
        }
      },
      "ChatEnrichmentContext": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "batch_id",
          "row_id",
          "proposal_id",
          "expected_version"
        ],
        "properties": {
          "batch_id": {
            "type": "integer",
            "minimum": 1
          },
          "row_id": {
            "type": "integer",
            "minimum": 1
          },
          "proposal_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ChatCandidateReference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "ChatEnrichmentCandidates": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "batch_id",
          "row_id",
          "proposal_id",
          "expected_version",
          "candidates"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "enrichment_candidates"
          },
          "batch_id": {
            "type": "integer",
            "minimum": 1
          },
          "row_id": {
            "type": "integer",
            "minimum": 1
          },
          "proposal_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          },
          "candidates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/ChatCandidateReference"
            }
          }
        }
      },
      "ChatReply": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "blocks",
          "tools"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 80000
          },
          "blocks": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ChatEnrichmentCandidates"
                },
                {
                  "$ref": "#/components/schemas/ChatEnrichmentResearch"
                }
              ]
            },
            "description": "0..1 bloc candidats non vide puis 0..1 bloc research ; chaque bloc au plus une fois, références identiques au binding."
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ChatError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "type",
              "description",
              "details"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "ChatEnrichmentResearch": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Bloc serveur de préparation de relance",
        "type": "object",
        "properties": {
          "type": {
            "const": "enrichment_research"
          },
          "batch_id": {
            "type": "integer",
            "minimum": 1
          },
          "row_id": {
            "type": "integer",
            "minimum": 1
          },
          "proposal_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "type",
          "batch_id",
          "row_id",
          "proposal_id",
          "expected_version"
        ],
        "additionalProperties": false
      }
    }
  }
}
